/* =============================================================================
 * Catppuccin Mocha — Rofi Theme
 * Designed to match the waybar floating-pill aesthetic
 * =========================================================================== */

* {
    /* ── Catppuccin Mocha palette ── */
    base:       #1e1e2e;
    mantle:     #181825;
    crust:      #11111b;
    surface0:   #313244;
    surface1:   #45475a;
    surface2:   #585b70;
    overlay0:   #6c7086;
    overlay1:   #7f849c;
    overlay2:   #9399b2;
    text:       #cdd6f4;
    subtext1:   #bac2de;
    subtext0:   #a6adc8;
    blue:       #89b4fa;
    lavender:   #b4befe;
    sapphire:   #74c7ec;
    sky:        #89dceb;
    teal:       #94e2d5;
    green:      #a6e3a1;
    yellow:     #f9e2af;
    peach:      #fab387;
    maroon:     #eba0ac;
    red:        #f38ba8;
    mauve:      #cba6f7;
    pink:       #f5c2e7;

    /* ── Widget defaults ── */
    background-color: transparent;
    text-color:       @text;
    border:           0px;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

/* =============================================================================
 * Window — the floating pill, mirrors waybar .modules-* styling
 * =========================================================================== */

window {
    background-color: @base;
    border:           2px solid;
    border-color:     @blue;
    border-radius:    16px;
    width:            480px;
    padding:          0px;
    location:         center;
    anchor:           center;
}

/* =============================================================================
 * Main layout
 * =========================================================================== */

mainbox {
    background-color: transparent;
    padding:          16px;
    spacing:          10px;
    children:         [ "inputbar", "listview", "message" ];
}

/* =============================================================================
 * Input bar — search field pill
 * =========================================================================== */

inputbar {
    background-color: @surface0;
    border-radius:    12px;
    padding:          10px 14px;
    spacing:          8px;
    children:         [ "prompt", "entry" ];
}

prompt {
    background-color: transparent;
    text-color:       @blue;
    vertical-align:   0.5;
}

entry {
    background-color: transparent;
    text-color:       @text;
    placeholder:      "Search applications…";
    placeholder-color: @overlay0;
    cursor:           text;
    vertical-align:   0.5;
}

/* =============================================================================
 * Application list
 * =========================================================================== */

listview {
    background-color: transparent;
    padding:          2px 0px;
    spacing:          2px;
    lines:            8;
    columns:          1;
    scrollbar:        false;
    fixed-height:     false;
    dynamic:          true;
}

/* =============================================================================
 * List elements
 * =========================================================================== */

element {
    border-radius:    10px;
    padding:          8px 10px;
    spacing:          10px;
    orientation:      horizontal;
}

/* normal — unselected */
element normal.normal {
    background-color: transparent;
    text-color:       @text;
}

element normal.urgent {
    background-color: transparent;
    text-color:       @red;
}

element normal.active {
    background-color: transparent;
    text-color:       @blue;
}

/* selected — highlighted row, mirrors waybar active workspace pill */
element selected.normal {
    background-color: @surface0;
    text-color:       @blue;
}

element selected.urgent {
    background-color: @red;
    text-color:       @base;
}

element selected.active {
    background-color: @blue;
    text-color:       @base;
}

/* alternate rows */
element alternate.normal {
    background-color: transparent;
    text-color:       @text;
}

element alternate.urgent {
    background-color: transparent;
    text-color:       @red;
}

element alternate.active {
    background-color: transparent;
    text-color:       @blue;
}

/* ── Icon ── */

element-icon {
    background-color: transparent;
    size:             22px;
    vertical-align:   0.5;
}

/* ── Label ── */

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    highlight:        bold #89b4fa;
}

/* =============================================================================
 * Mode switcher (sidebar)
 * =========================================================================== */

mode-switcher {
    background-color: transparent;
    spacing:          6px;
}

button {
    background-color: @surface0;
    border-radius:    10px;
    padding:          6px 14px;
    text-color:       @overlay1;
    cursor:           pointer;
}

button selected {
    background-color: @blue;
    text-color:       @base;
}

/* =============================================================================
 * Message / error bar
 * =========================================================================== */

message {
    background-color: @surface0;
    border-radius:    10px;
    padding:          8px 14px;
}

textbox {
    background-color: transparent;
    text-color:       @subtext0;
}
